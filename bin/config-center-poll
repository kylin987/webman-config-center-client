#!/usr/bin/env php
<?php

$autoload = $_composer_autoload_path ?? (is_file(dirname(__DIR__) . '/vendor/autoload.php') ? dirname(__DIR__) . '/vendor/autoload.php' : dirname(__DIR__, 3) . '/autoload.php');
require $autoload;

$config = Kylin987\WebmanConfigCenter\ConfigLoader::load();
$interval = max(10, (int) ($config['poll_interval'] ?? 60));
$configuredJitter = $config['poll_jitter_seconds'] ?? null;
$jitter = $configuredJitter === null || $configuredJitter === ''
    ? min(30, intdiv($interval, 2))
    : max(0, (int) $configuredJitter);
$jitter = min($jitter, max(0, $interval - 1));
$sync = new Kylin987\WebmanConfigCenter\ConfigSynchronizer($config);
$logger = new Kylin987\WebmanConfigCenter\ConfigCenterLogger($config);
$wasFailing = false;
while (true) {
    try {
        $sync->syncAll();
        if ($wasFailing) {
            $logger->info('config-center poll recovered');
        }
        $wasFailing = false;
    } catch (\Throwable $exception) {
        $wasFailing = true;
        $logger->warningThrottled('poll.failed', 'config-center poll failed; keep using local config files', [
            'exception' => $exception,
        ]);
    }
    sleep(random_int(max(1, $interval - $jitter), $interval + $jitter));
}
