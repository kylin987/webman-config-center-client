#!/usr/bin/env php
<?php

$autoload = $_composer_autoload_path ?? (is_file(dirname(__DIR__) . '/vendor/autoload.php') ? dirname(__DIR__) . '/vendor/autoload.php' : dirname(__DIR__, 3) . '/autoload.php');
require $autoload;

$config = Yhs\WebmanConfigCenter\ConfigLoader::load();
$sync = new Yhs\WebmanConfigCenter\ConfigSynchronizer($config);
$logger = new Yhs\WebmanConfigCenter\ConfigCenterLogger($config);
try {
    foreach ($sync->syncAll() as $result) {
        fwrite(STDOUT, json_encode($result, JSON_UNESCAPED_UNICODE) . PHP_EOL);
    }
} catch (\Throwable $exception) {
    $logger->warningThrottled('sync.failed', 'config-center sync failed; keep using local config files', [
        'exception' => $exception,
    ]);
    fwrite(STDERR, 'config-center sync failed; keep using local config files' . PHP_EOL);
    if (!empty($config['fail_on_error'])) {
        exit(1);
    }
}
